rules_version = '2';
// Klarsinn – Firestore-Sicherheitsregeln
// Jede angemeldete Person darf nur ihr eigenes Dokument lesen, schreiben und löschen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && request.resource.size() < 900000;
    }
  }
}
